# ========================
DEBUG=True
SECRET_KEY=django-insecure--)i3x_fg)a$$d24)13hq=ydp(f9s$*re3t*shfnkk$o7(r$*pw
ALLOWED_HOSTS=localhost,127.0.0.1

# ========================
# 数据库配置 (MySQL)
# ========================
DB_NAME=project_zhihui
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=localhost
DB_PORT=3306

# ========================
# Redis 配置
# ========================
REDIS_URL=redis://127.0.0.1:6379/1

# ========================
# Celery 配置
# ========================
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ========================
# 邮件服务配置 (QQ SMTP)
# ========================
# 需要开启QQ邮箱的SMTP服务并获取授权码
EMAIL_HOST_USER=your-qq-email@qq.com
EMAIL_HOST_PASSWORD=your-qq-smtp-authorization-code

# ========================
# 第三方服务API密钥
# ========================
# 获取地址：https://sparklite.com/console
Spark_Lite_API=your-api-key-here
# 获取地址：https://console.amap.com/dev/key/app
Gaode_POI_API=your-api-key-here

# ========================
# 智能体（Python 版，替代 Dify）
# ========================
# 任意 OpenAI 兼容接口均可：
#   通义千问 DashScope  https://dashscope.aliyuncs.com/compatible-mode/v1   模型如 qwen-plus / qwen-max
#   硅基流动 SiliconFlow https://api.siliconflow.cn/v1                     模型如 deepseek-ai/DeepSeek-V3
#   DeepSeek 官方        https://api.deepseek.com                          模型如 deepseek-chat
#   本地 Ollama          http://127.0.0.1:11434/v1                         模型如 qwen2.5:14b
AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_API_KEY=your-api-key-here
AGENT_LLM_MODEL=qwen-plus
# 结构化抽取用的模型（可选，留空=同上）
AGENT_LLM_FAST_MODEL=
# 填宝发布需求后的状态：under_review(审核中，与表单发布一致) / in_progress(直接上线，与旧 Dify 一致)
AGENT_PUBLISH_STATUS=under_review
